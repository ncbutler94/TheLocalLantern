# Dependencies
node_modules/
**/node_modules/
frontend/node_modules/
backend/node_modules/

# Build / cache
.cache/
**/.cache/
dist/
build/
.vite/
# Env files
# Block everything by default
.env
.env.*

# But ALLOW frontend env files (they only contain REACT_APP_* vars,
# which are bundled into the public JS anyway — already not secret)
!frontend/.env
!frontend/.env.development
!frontend/.env.production
!frontend/.env.example

# Always block local override files (so devs can have personal settings
# without committing them)
.env.local
.env.*.local

# Logs
*.log

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Keys / credentials (never commit)
backend/gcs-key.json
gcs-key.json
*service-account*.json
*.pem
*.key

# Capacitor / build artifacts
android/
build.zip